APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=my_app
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Platform OpenAI key. Powers Optus, the in-app assistant. Distinct from the
# per-company OpenAI integrations that AI Agents use.
OPENAI_API_KEY=
OPENAI_ORGANIZATION=
OPTUS_MODEL=gpt-4o-mini

# Our managed Evolution API server. Every WhatsApp account in every company
# connects through this one deployment — customers no longer supply their own.
# New integrations are created with these values copied onto them, so a company
# can still be pointed at a different Evolution server later.
EVOLUTION_API_URL=
EVOLUTION_API_KEY=

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Digital signature
# ---------------------------------------------------------------------------
# Where signature vendors deliver webhooks. Kept separate from APP_URL, which
# is still localhost in some environments — a webhook registered against
# localhost silently never fires.
SIGNATURE_CALLBACK_BASE_URL=https://crm-api.optomyze.io

SIGNATURE_DEFAULT_PROVIDER=clicksign
SIGNATURE_RETRY_ATTEMPTS=5
SIGNATURE_AUDIT_RETENTION_DAYS=180

# Clicksign (API 3.0). Access tokens are per-company and stored encrypted in
# the database, not here — these settings only describe how to reach the API.
CLICKSIGN_ENVIRONMENT=sandbox
CLICKSIGN_TIMEOUT=30

# UNSET ON PURPOSE. Clicksign's webhook payload carries the signed file as a
# relative path and its documentation never states which host serves it.
# Rather than guess, the download fails with an explanation until this is set.
# Confirm the origin against a real sandbox delivery, then fill it in.
CLICKSIGN_DOWNLOAD_BASE_URL=
